# ── Supabase (Postgres + Storage) ───────────────────────────────────────────
# Project Settings → API in the Supabase dashboard.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never expose to the client

# Prisma connection strings — Project Settings → Database in Supabase.
# DATABASE_URL uses the pooled connection (port 6543, pgbouncer) for serverless.
# DIRECT_URL uses the direct connection (port 5432), required by `prisma migrate`.
DATABASE_URL="postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:5432/postgres"

# ── LLM provider ─────────────────────────────────────────────────────────────
# "openai" or "anthropic". Chat completion uses this provider.
# Embeddings ALWAYS use OpenAI (text-embedding-3-small) regardless of this
# setting, because Anthropic has no embeddings API — OPENAI_API_KEY is
# therefore required even when LLM_PROVIDER=anthropic.
LLM_PROVIDER=openai

OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides — sensible defaults are used if omitted.
# LLM_CHAT_MODEL=gpt-4o-mini
# LLM_GUARD_MODEL=gpt-4o-mini
# LLM_EMBEDDING_MODEL=text-embedding-3-small
